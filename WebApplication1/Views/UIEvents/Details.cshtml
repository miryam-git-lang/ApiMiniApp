@model ApiMiniApp.Dtos.EventReturnDto

@{
    ViewData["Title"] = Model?.Title ?? "Event Details";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <a href="@Url.Action("Index", "UIEvents")" class="btn btn-secondary mb-3">← Back to Events</a>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow">
                    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                    {
                        <img src="@Model.BannerImageUrl" class="card-img-top" alt="@Model.Title" style="height: 400px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 400px; color: white; font-size: 24px;">
                            <span>📋 No Image</span>
                        </div>
                    }
                    
                    <div class="card-body">
                        <h1 class="card-title">@Model.Title</h1>
                        
                        <div class="row my-4">
                            <div class="col-md-6">
                                <p>
                                    <strong>📅 Date:</strong><br>
                                    @Model.Date.ToString("dddd, dd MMMM yyyy HH:mm")
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p>
                                    <strong>📍 Location:</strong><br>
                                    @Model.Location
                                </p>
                            </div>
                        </div>

                        <hr>

                        <div class="mb-4">
                            <h4>Description</h4>
                            <p>@(Model.Description ?? "No description")</p>
                        </div>

                        @if (Model.Organizer != null)
                        {
                            <div class="mb-4 p-3 bg-light rounded">
                                <h5>Organizer</h5>
                                <p>
                                    <strong>@Model.Organizer.Name</strong>
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h5 class="card-title">🎫 Tickets</h5>
                        @if (Model.Tickets != null && Model.Tickets.Count > 0)
                        {
                            <p class="text-muted">Available @Model.Tickets.Count tickets</p>
                            <a href="#" class="btn btn-success btn-lg w-100">Buy Ticket</a>
                        }
                        else
                        {
                            <p class="text-muted">Tickets not available</p>
                            <button class="btn btn-success btn-lg w-100" disabled>Tickets Sold Out</button>
                        }
                    </div>
                </div>

                <div class="card shadow mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Actions</h5>
                        <a href="@Url.Action("Edit", "UIEvents", new { id = Model.Id })" class="btn btn-warning w-100 mb-2">✏️ Edit Event</a>
                        <a href="@Url.Action("Delete", "UIEvents", new { id = Model.Id })" class="btn btn-danger w-100">🗑️ Delete Event</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            Event not found
        </div>
    }
</div>

