@model List<ApiMiniApp.Dtos.EventReturnDto>

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>📅 All Events</h1>
            <p class="text-muted">List of available events</p>
        </div>
        <div class="col-md-4 text-end">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Create", "UIEvents")" class="btn btn-primary">+ Create Event</a>
                <a href="@Url.Action("CreateFile", "UIEvents")" class="btn btn-success">📤 Upload File</a>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">
            @foreach (var eventItem in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm hover-shadow" style="transition: transform 0.3s;">
                        @if (!string.IsNullOrEmpty(eventItem.BannerImageUrl))
                        {
                            <img src="@eventItem.BannerImageUrl" class="card-img-top" alt="@eventItem.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px; color: white; font-size: 18px;">
                                <span>📋 No Image</span>
                            </div>
                        }
                        
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.Title</h5>
                            <p class="card-text text-muted small">
                                @if (eventItem.Description != null && eventItem.Description.Length > 80)
                                {
                                    @eventItem.Description.Substring(0, 80)<text>...</text>
                                }
                                else
                                {
                                    @eventItem.Description
                                }
                            </p>
                            
                            <div class="event-info mb-3">
                                <small class="d-block text-muted mb-1">
                                    📍 <strong>@eventItem.Location</strong>
                                </small>
                                <small class="d-block text-muted">
                                    📅 @eventItem.Date.ToString("dd.MM.yyyy HH:mm")
                                </small>
                            </div>

                            @if (eventItem.Organizer != null)
                            {
                                <small class="d-block text-muted mb-2">
                                    👤 Organizer: @eventItem.Organizer.Name
                                </small>
                            }
                        </div>
                        
                        <div class="card-footer bg-white border-top">
                            <div class="btn-group w-100" role="group">
                                <a href="@Url.Action("Details", "UIEvents", new { id = eventItem.Id })" class="btn btn-sm btn-outline-primary flex-fill">📖 Details</a>
                                <a href="@Url.Action("Edit", "UIEvents", new { id = eventItem.Id })" class="btn btn-sm btn-outline-warning flex-fill">✏️ Edit</a>
                                <a href="@Url.Action("Delete", "UIEvents", new { id = eventItem.Id })" class="btn btn-sm btn-outline-danger flex-fill">🗑️ Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-info text-center p-5" role="alert">
                    <h4 class="mb-3">📭 No Events</h4>
                    <p class="mb-3">Unfortunately, no events were found.</p>
                    <a href="@Url.Action("Create", "UIEvents")" class="btn btn-primary">Create First Event</a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .hover-shadow:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
        transform: translateY(-5px);
    }

    .event-info {
        border-top: 1px solid #e9ecef;
        padding-top: 10px;
    }

    .btn-group .btn {
        font-size: 12px;
        padding: 4px 8px !important;
    }
</style>

