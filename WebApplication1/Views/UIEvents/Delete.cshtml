@model ApiMiniApp.Dtos.EventReturnDto

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">🗑️ Delete Event</h4>
                </div>
                
                <div class="card-body">
                    @if (Model != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            <h5>⚠️ Are you sure?</h5>
                            <p>You are about to delete the following event:</p>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded">
                            <h5 class="card-title">@Model.Title</h5>
                            <p class="text-muted mb-2">
                                📅 @Model.Date.ToString("dd.MM.yyyy HH:mm")
                            </p>
                            <p class="text-muted">
                                📍 @Model.Location
                            </p>
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <p class="text-muted">
                                    @(Model.Description.Length > 100 ? Model.Description.Substring(0, 100) + "..." : Model.Description)
                                </p>
                            }
                        </div>

                        <form method="post" asp-action="Delete" asp-controller="UIEvents">
                            <input type="hidden" name="id" value="@Model.Id">
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="@Url.Action("Index", "UIEvents")" class="btn btn-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger">Delete Event</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-danger" role="alert">
                            Event not found
                        </div>
                        <a href="@Url.Action("Index", "UIEvents")" class="btn btn-secondary w-100">Back to Events</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

