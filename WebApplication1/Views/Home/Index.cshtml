@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p class="lead">This is the main page of the event management application.</p>
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">🔐 Already registered?</h5>
                <p class="card-text">Sign in to your account</p>
                <a href="@Url.Action("Login", "UIAccount")" class="btn btn-primary">Sign In</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 text-center">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">✍️ New user?</h5>
                <p class="card-text">Create your account</p>
                <a href="@Url.Action("Register", "UIAccount")" class="btn btn-success">Register</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 text-center">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">📅 Events</h5>
                <p class="card-text">View all events</p>
                <a href="@Url.Action("Index", "UIEvents")" class="btn btn-info">Events</a>
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<div class="row mt-5">
    <div class="col-md-12">
        <h3>Platform Features</h3>
        <ul class="list-group">
            <li class="list-group-item">✔️ Event Management</li>
            <li class="list-group-item">✔️ Event Registration</li>
            <li class="list-group-item">✔️ Ticket Management</li>
            <li class="list-group-item">✔️ User Profile</li>
        </ul>
    </div>
</div>
