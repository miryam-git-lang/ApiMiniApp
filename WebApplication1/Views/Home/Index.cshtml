@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Добро пожаловать</h1>
    <p class="lead">Это главная страница приложения для управления событиями.</p>
</div>

<div class="row mt-5">
    <div class="col-md-4 text-center">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">🔐 Уже зарегистрированы?</h5>
                <p class="card-text">Войдите в ваш аккаунт</p>
                <a href="@Url.Action("Login", "UIAccount")" class="btn btn-primary">Войти</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 text-center">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">✍️ Новый пользователь?</h5>
                <p class="card-text">Создайте свой аккаунт</p>
                <a href="@Url.Action("Register", "UIAccount")" class="btn btn-success">Зарегистрироваться</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 text-center">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">📅 События</h5>
                <p class="card-text">Посмотреть все события</p>
                <a href="@Url.Action("Index", "Event")" class="btn btn-info">События</a>
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<div class="row mt-5">
    <div class="col-md-12">
        <h3>Особенности платформы</h3>
        <ul class="list-group">
            <li class="list-group-item">✔️ Управление событиями</li>
            <li class="list-group-item">✔️ Регистрация на события</li>
            <li class="list-group-item">✔️ Управление билетами</li>
            <li class="list-group-item">✔️ Профиль пользователя</li>
        </ul>
    </div>
</div>

